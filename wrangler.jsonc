{
  "$schema": "./backend/node_modules/wrangler/config-schema.json",
  "name": "aplicacaoweb-sistema-personal-trainer-treinador",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frs-coach",
      "database_id": "d778c3b7-5ab1-4723-8f91-00c42d938e4c",
      "migrations_dir": "backend/migrations-d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "frs-personal-media",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "frs-coach",
          "database_id": "d778c3b7-5ab1-4723-8f91-00c42d938e4c",
          "migrations_dir": "backend/migrations-d1",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "frs-personal-media",
        },
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://aplicacaoweb-sistema-personal-trainer-treinador.pages.dev",
        "PUBLIC_SITE_URL": "https://aplicacaoweb-sistema-personal-trainer-treinador.pages.dev/",
        "PUBLIC_API_URL": "https://aplicacaoweb-sistema-personal-trainer-treinador.pages.dev",
        "EMAIL_FROM": "fabiogisel7@gmail.com",
        "BREVO_FROM_NAME": "FRS Personal Trainer",
        "SESSION_TTL_SECONDS": "43200",
        "MERCADO_PAGO_PUBLIC_KEY": "APP_USR-2a58ba5d-d4ee-4cc5-bc2a-d8e1b86aee70",
      },
    },
  },
}
