{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frs-coach-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://aplicacaoweb-sistema-personal-trainer-treinador.pages.dev",
    "PUBLIC_SITE_URL": "https://aplicacaoweb-sistema-personal-trainer-treinador.pages.dev/",
    "PUBLIC_API_URL": "https://frs-coach-api.fabioribeirodev.workers.dev",
    "EMAIL_FROM": "fabiogisel7@gmail.com",
    "BREVO_FROM_NAME": "FRS Personal Trainer",
    "SESSION_TTL_SECONDS": "43200",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frs-coach",
      "database_id": "d778c3b7-5ab1-4723-8f91-00c42d938e4c",
      "migrations_dir": "migrations-d1",
    },
  ],
}
